const N = 8

var data: array[N, int]

proc fillData() =
  for i in 0 ..< N:
    data[i] = (N - i) * 3 % 7

proc sortData() =
  var i = 1
  while i < N:
    let key = data[i]
    var j = i - 1
    while j >= 0 and data[j] > key:
      data[j + 1] = data[j]
      j = j - 1
    data[j + 1] = key
    i = i + 1

thread main() =
  fillData()
  sortData()
  for i in 0 ..< N:
    echo data[i]
