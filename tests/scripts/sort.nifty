# Insertion sort over a fixed global array. No recursion, O(1) stack,
# and every array index is proven in bounds at compile time - the
# generated C has no bounds checks at all.

const N = 8

var data: array[N, 0 .. 6]

proc fillData() =
  for i in 0 ..< N:
    data[i] = (N - i) * 3 % 7

proc sortData() =
  var i: 1 .. N = 1
  while i < N:
    let key = data[i]
    var j: -1 .. N - 2 = i - 1
    while j >= 0 and data[j] > key:
      data[j + 1] = data[j]
      j = j - 1
    data[j + 1] = key
    i = i + 1

thread main() =
  fillData()
  sortData()
  for i in 0 ..< N:
    echo data[i]
