thread main() =
  var sum: 0 .. 100 = 0
  for i in 0 ..< 5:
    if sum <= 90:
      sum = sum + i
  echo sum
  var sum2: 0 .. 100 = 0
  for j in 1 .. 5:
    if sum2 <= 90:
      sum2 = sum2 + j
  echo sum2
  var n: 0 .. 10 = 0
  while n <= 8:
    n = n + 2
  echo n
  var k: 0 .. 3 = 0
  loop:
    if k >= 3:
      break
    k = k + 1
  echo k
