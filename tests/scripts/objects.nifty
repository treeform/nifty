object Vec2 =
  x: -1000 .. 1000
  y: -1000 .. 1000

object Rect =
  pos: Vec2
  size: Vec2

func area(r: Rect): int =
  return r.size.x * r.size.y

proc grow(r: var Rect, amount: 0 .. 100) =
  let nx = r.size.x + amount
  if nx <= 1000:
    r.size.x = nx
  let ny = r.size.y + amount
  if ny <= 1000:
    r.size.y = ny

thread main() =
  var screen: Rect
  screen.size.x = 10
  screen.size.y = 5
  echo area(screen)
  grow(screen, 2)
  echo area(screen)
  var copy = screen
  copy.size.x = 100
  echo screen.size.x
  echo copy.size.x
