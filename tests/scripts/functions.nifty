var total: 0 .. 1000

func square(x: 0 .. 1000): int =
  return x * x

func add(a, b: 0 .. 1000): int =
  return a + b

proc bump(x: var 0 .. 100) =
  let t = x
  if t < 100:
    x = t + 1

proc addTotal(x: 0 .. 100) =
  if total <= 900:
    total = total + x

thread main() =
  echo square(4)
  echo add(2, 3)
  var n: 0 .. 100 = 10
  bump(n)
  bump(n)
  echo n
  addTotal(7)
  addTotal(5)
  echo total
