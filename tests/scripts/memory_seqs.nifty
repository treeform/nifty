# Runtime-sized sequences preserve data while growing and initialize new slots.

proc append(values: var seq[int], value: int): bool =
  return values.push(value)

thread main() =
  var values: seq[int]
  echo values.len
  echo append(values, 12)
  echo values.add(34)
  echo values.resize(4)
  echo values.get(0).or(-1), " ", values.get(1).or(-1)
  echo values.get(2).or(-1), " ", values.get(3).or(-1)
  echo values.get(-1).ok, " ", values.get(4).ok
  var copied: seq[int]
  echo copied.copyFrom(values)
  echo values.resize(1)
  echo values.len, " ", copied.len
  if copied.len > 0:
    echo copied.pop()
  echo copied.len
  for value in values:
    echo value
  values.clear()
  echo values.len
