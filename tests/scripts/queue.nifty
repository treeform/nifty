# Two threads sharing a bounded queue under a lock. The fixed capacity
# IS the backpressure: push returns false when full. The checker knows
# q is shared by both threads, so every access must be inside
# "with qLock:" - and inside the lock its length facts are trusted.

const QueueSize = 4
const Items = 100

var q: queue[QueueSize, 0 .. 99]
var qLock: Lock

thread producer() =
  var i: 0 .. Items = 0
  loop:
    if i >= Items:
      break
    var sent = false
    with qLock:
      sent = q.push(i)
    if sent:
      i = i + 1

thread consumer() =
  var received: 0 .. Items = 0
  var sum: 0 .. 10000 = 0
  loop:
    if received >= Items:
      break
    var v: -1 .. 99 = -1
    with qLock:
      if q.len > 0:
        v = q.pop()
    if sum <= 9900 and v >= 0:
      sum = sum + v
      received = received + 1
  echo "sum: ", sum
