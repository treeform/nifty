# Two threads sharing a bounded ring buffer under a lock.
# The fixed capacity IS the backpressure. The checker knows queue, head,
# tail, and count are shared by both threads, so every access must be
# inside "with queueLock:" - and inside the lock, tests on them are
# trusted (no other thread can slip in while we hold it).

const QueueSize = 4
const Items = 100

var queue: array[QueueSize, 0 .. 99]
var head: 0 ..< QueueSize
var tail: 0 ..< QueueSize
var count: 0 .. QueueSize
var queueLock: Lock

proc tryPush(v: 0 .. 99): bool =
  var ok = false
  with queueLock:
    if count < QueueSize:
      queue[tail] = v
      tail = (tail + 1) % QueueSize
      count = count + 1
      ok = true
  return ok

proc tryPop(): -1 .. 99 =
  var v: -1 .. 99 = -1
  with queueLock:
    if count > 0:
      v = queue[head]
      head = (head + 1) % QueueSize
      count = count - 1
  return v

thread producer() =
  var i: 0 .. Items = 0
  loop:
    if i >= Items:
      break
    if tryPush(i):
      i = i + 1

thread consumer() =
  var received: 0 .. Items = 0
  var sum: 0 .. 10000 = 0
  loop:
    if received >= Items:
      break
    let v = tryPop()
    if sum <= 9900 and v >= 0:
      sum = sum + v
      received = received + 1
  echo "sum: ", sum
