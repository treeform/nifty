# Two threads sharing a bounded ring buffer under a lock.
# The fixed capacity IS the backpressure: a full queue makes the
# producer retry, an empty queue makes the consumer retry.

const QueueSize = 4
const Items = 100

var queue: array[QueueSize, int]
var head: int
var tail: int
var count: int
var queueLock: Lock

proc tryPush(v: int): bool =
  var ok = false
  withLock queueLock:
    if count < QueueSize:
      queue[tail] = v
      tail = (tail + 1) % QueueSize
      count = count + 1
      ok = true
  return ok

proc tryPop(): int =
  var v = -1
  withLock queueLock:
    if count > 0:
      v = queue[head]
      head = (head + 1) % QueueSize
      count = count - 1
  return v

thread producer() =
  var i = 0
  loop:
    if i >= Items:
      break
    if tryPush(i):
      i = i + 1

thread consumer() =
  var received = 0
  var sum = 0
  loop:
    if received >= Items:
      break
    let v = tryPop()
    if v >= 0:
      sum = sum + v
      received = received + 1
  echo "sum: ", sum
