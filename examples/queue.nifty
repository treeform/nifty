# Two threads sharing a bounded ring buffer under a lock.
# The fixed capacity IS the backpressure, and the declared ranges on
# head, tail, and count are invariants every write must prove - which
# is what makes queue[head] and queue[tail] check-free at runtime.

const QueueSize = 4
const Items = 100

var queue: array[QueueSize, 0 .. 99]
var head: 0 ..< QueueSize
var tail: 0 ..< QueueSize
var count: 0 .. QueueSize
var queueLock: Lock

proc tryPush(v: 0 .. 99): bool =
  var ok = false
  with queueLock:
    let n = count
    if n < QueueSize:
      queue[tail] = v
      tail = (tail + 1) % QueueSize
      count = n + 1
      ok = true
  return ok

proc tryPop(): -1 .. 99 =
  var v: -1 .. 99 = -1
  with queueLock:
    let n = count
    if n > 0:
      v = queue[head]
      head = (head + 1) % QueueSize
      count = n - 1
  return v

thread producer() =
  var i: 0 .. Items = 0
  loop:
    if i >= Items:
      break
    if tryPush(i):
      i = i + 1

thread consumer() =
  var received: 0 .. Items = 0
  var sum: 0 .. 10000 = 0
  loop:
    if received >= Items:
      break
    let v = tryPop()
    if sum <= 9900 and v >= 0:
      sum = sum + v
      received = received + 1
  echo "sum: ", sum
