# Division by zero is impossible in nifty - not because it traps at
# runtime, but because every divisor must be PROVEN nonzero at compile
# time. The generated C has no division checks: / compiles to bare C /.
#
# These do not compile:
#   echo 10 / 0        error: division by zero
#   var u: int
#   ...  echo 10 / u   error: cannot prove 'u' is not zero here;
#                             guard the division with 'if u != 0:'
#   echo 10 / g        error: cannot divide by global 'g': another thread
#                             could zero it between a test and this
#                             division; snapshot it first

const K = 4

var g: int

# Guard style: the early return proves b != 0 for everything after it.
func safeDiv(a: 0 .. 100000, b: int): int =
  if b == 0:
    return 0
  return a / b

thread main() =
  # Constants and nonzero initializers are proven by value.
  echo 100 / K
  var q = 4
  echo 100 / q

  # A test proves a local for exactly the branch where it holds.
  var b = 0
  if b != 0:
    echo 1 / b
  else:
    echo -1

  # The else branch of == 0 is a proof too.
  var m = 3
  if m == 0:
    echo -3
  else:
    echo 30 / m

  echo safeDiv(100, 0)
  echo safeDiv(100, 5)

  # Globals can change under you (another thread!), so flow tests never
  # attach to them. Snapshot to a local, then test the snapshot.
  g = 7
  let snap = g
  if snap != 0:
    echo 700 / snap

  # A while condition re-proves its facts on every entry.
  var d = 8
  while d != 0:
    echo 64 / d
    d = d / 2
