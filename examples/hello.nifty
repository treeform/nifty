# The smallest useful nifty program: a func, a proc, a global, a thread.
# Every division, index, and arithmetic op is proven safe at compile time,
# so ranges appear on anything that grows.

const MaxItems = 10

var total: 0 .. 1000

func double(x: 0 .. 100): 0 .. 200 =
  return x * 2

proc addTotal(x: 0 .. 200) =
  # total is only touched by the main thread, so the checker treats it
  # like a local: the test below proves the store fits 0 .. 1000.
  if total <= 800:
    total = total + x

thread main() =
  for i in 0 ..< MaxItems:
    addTotal(double(i))
  echo "total: ", total
