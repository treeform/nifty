# A small HTTP pipeline with scoped growable strings. Requests carry only
# a slot and route; responses carry a slot into shared owned storage.
# Workers build pages and responses in local strings, then copy the result
# into the shared slot under its lock. The writer takes its own copy before
# unlocking, so no borrowed allocation crosses a channel or lock boundary.
#
# Request bytes, connection slots, and channel queues retain explicit
# limits. Page and response storage grows to the amount actually needed.
#
#   nifty build examples/httpd.nifty
#   cd examples && ./httpd
#   curl http://localhost:8080/

const Port = 8080
const MaxConnections = 8    # open connections the io thread juggles
const PollSlots = MaxConnections + 1  # plus the listener
const Workers = 4
const RequestMax = 2048     # Explicit request-header limit.
const ReadChunk = 4096      # Fixed scratch storage for each file read.
const MaxFileReads = 4096   # Bound work per request, including the EOF read.
const MaxResponseSize = MaxFileReads * ReadChunk + 512
const NoSignal = 524288     # Darwin MSG_NOSIGNAL, like the socket options below.

object PollEntry =          # one row of the poll set (C's struct pollfd)
  socket: int32
  events: int16             # what we wait for (1 = readable)
  returned: int16           # what actually happened

object Connection =         # one connection slot; socket 0 means free
  socket: int32
  busy: bool                # request handed to a worker, answer pending

object Request =
  slot: 0 ..< MaxConnections
  route: 0 .. 2            # 0 = malformed, 1 = page, 2 = not found.

# The C names stop at this boundary: nifty declares its own names and
# the string after each one is the C symbol the linker resolves.
extern "libc":
  proc openSocket "socket" (domain: int32, kind: int32, protocol: int32): int32
  proc setSocketOption "setsockopt" (socket: int32, level: int32, option: int32, value: var int32, size: int32): int32
  proc bindSocket "bind" (socket: int32, address: array[16, uint8], addressSize: int32): int32
  proc listen(socket: int32, backlog: int32): int32
  proc acceptConnection "accept" (socket: int32, address: int64, addressSize: int64): int32
  proc poll(entries: var array[PollSlots, PollEntry], count: int32, timeoutMs: int32): int32
  proc read(descriptor: int32, buffer: var string[RequestMax], capacity: int64): int64
  proc readChunk "read" (descriptor: int32, buffer: var string[ReadChunk], capacity: int64): int64
  proc sendChunk "send" (descriptor: int32, buffer: string[ReadChunk], size: int64, flags: int32): int64
  proc openFile "open" (path: string[16], flags: int32): int32
  proc close(descriptor: int32): int32

# The pipeline: io -> requests -> workers -> responses -> writer.
# A channel is a bounded blocking queue with the semaphore built in -
# it needs no lock and no handshake, and it works from the first
# instruction, so there is no startup dance at all.
var requests: channel[MaxConnections, Request]
var responses: channel[MaxConnections, 0 ..< MaxConnections]

# The connection table is real shared state (io fills it, the writer
# empties it), so it is a plain global under a lock, and the checker
# holds every access to that.
var connections: array[MaxConnections, Connection]
var responseTexts: array[MaxConnections, string]
var connectionsLock: Lock

# Classify the route directly; no path buffer or path-size parameter.
func route(request: string[RequestMax]): 0 .. 2 =
  if not request.startsWith("GET "):
    return 0
  let pathEnd = request.find(" HTTP/")
  if not pathEnd.ok:
    return 0
  if request.startsWith("GET / HTTP/") or request.startsWith("GET /index.html HTTP/"):
    return 1
  return 2

# The caller owns page. This helper grows it as file chunks arrive.
# Failure includes allocation failure and exhausting the request-work cap;
# a partial page is never reported as a successfully loaded document.
proc loadPage(page: var string): bool =
  page.clear()
  var fileName: string[16] = "index.html"
  fileName.addByte(0)
  let file = openFile(fileName, 0)
  if file < 0:
    return false
  var complete = false
  for attempt in 0 ..< MaxFileReads:
    var chunk: string[ReadChunk]
    let bytesRead = readChunk(file, chunk, ReadChunk)
    if bytesRead < 0 or bytesRead > ReadChunk:
      break
    if bytesRead == 0:
      complete = true
      break
    chunk.setLen(bytesRead)
    if not page.add(chunk):
      break
  discard file.close()
  return complete

# No response capacity calculation: each append reports allocation failure.
proc buildResponse(status: string, body: string, response: var string): bool =
  response.clear()
  if not response.add("HTTP/1.1 "):
    return false
  if not response.add(status):
    return false
  if not response.add("\r\nContent-Type: text/html\r\nContent-Length: "):
    return false
  if not response.addNum(body.len):
    return false
  if not response.add("\r\nConnection: close\r\n\r\n"):
    return false
  return response.add(body)

# A successful write can be short. Keep only fixed-size socket scratch
# storage and advance by the bytes actually sent. The loop is bounded even
# if a peer accepts just one byte per call; failure closes the connection.
proc writeAll(socket: int32, text: string): bool =
  let length = text.len
  if length > MaxResponseSize:
    return false
  var sent: 0 .. MaxResponseSize = 0
  while sent < length max MaxResponseSize:
    var chunk: string[ReadChunk]
    chunk.copyRange(text, sent, length)
    let written = sendChunk(socket, chunk, chunk.len, NoSignal)
    if written <= 0 or written > ReadChunk:
      return false
    if written > chunk.len:
      return false
    let next = sent + written
    if next > MaxResponseSize:
      return false
    sent = next
  return sent == length

# The one listening socket, owned by the io thread.
proc listenSocket(): int32? =
  let socket = openSocket(2, 1, 0)    # AF_INET, SOCK_STREAM
  if socket < 0:
    return none
  var enable: int32 = 1
  discard setSocketOption(socket, 65535, 4, enable, 4)  # SOL_SOCKET, SO_REUSEADDR
  var address: array[16, uint8]
  address[1] = 2                      # Darwin: sin_family at byte 1
  address[2] = Port / 256             # sin_port, big-endian
  address[3] = Port % 256             # sin_addr 0.0.0.0 is already zero
  if bindSocket(socket, address, 16) != 0:
    discard socket.close()
    return none
  if listen(socket, 16) != 0:
    discard socket.close()
    return none
  return socket

# The io thread: accepts, reads, parses, dispatches. Note where the
# send sits: after the lock block, never inside one - the checker
# rejects blocking while holding a lock outright.
thread io() =
  var serverSocket: int32 = -1
  let opened = listenSocket()
  if opened.ok:
    serverSocket = opened
    echo "serving http://localhost:", Port, "/"
  loop:
    if serverSocket < 0:
      break
    var pollSet: array[PollSlots, PollEntry]
    pollSet[0].socket = serverSocket
    pollSet[0].events = 1             # readable
    with connectionsLock:
      for i in 0 ..< MaxConnections:
        if connections[i].socket > 0 and not connections[i].busy:
          pollSet[i + 1].socket = connections[i].socket
        else:
          pollSet[i + 1].socket = -1  # poll ignores negative descriptors
        pollSet[i + 1].events = 1
    if poll(pollSet, PollSlots, 200) > 0:
      # The listener: take the connection into a free slot, or shed it.
      if pollSet[0].returned != 0:
        let client = acceptConnection(serverSocket, 0, 0)
        if client > 0:
          var placed = false
          with connectionsLock:
            for i in 0 ..< MaxConnections:
              if not placed and connections[i].socket == 0:
                connections[i].socket = client
                connections[i].busy = false
                placed = true
          if not placed:
            discard client.close()          # full house
      # Readable connections: read the request, parse it, and send it
      # into the pool - the kernel stands exactly one worker up.
      for i in 0 ..< MaxConnections:
        if pollSet[i + 1].returned != 0:
          var clientSocket: int32 = 0
          with connectionsLock:
            if connections[i].socket > 0 and not connections[i].busy:
              clientSocket = connections[i].socket
          if clientSocket > 0:
            var requestText: string[RequestMax]
            let bytesRead = clientSocket.read(requestText, RequestMax)
            if bytesRead > 0 and bytesRead <= RequestMax:
              requestText.setLen(bytesRead)
              var request: Request
              request.slot = i
              request.route = route(requestText)
              with connectionsLock:
                connections[i].busy = true
              requests.send(request)
            else:                     # closed or unreadable: drop it
              with connectionsLock:
                connections[i].socket = 0
              discard clientSocket.close()

# Each worker owns temporary strings only for one loop iteration.
thread Workers worker() =
  loop:
    let request = requests.recv()
    var text: string
    var built = false
    if request.route == 0:
      built = buildResponse("400 Bad Request", "<h1>400 bad request</h1>", text)
    elif request.route == 1:
      var page: string
      if loadPage(page):
        built = buildResponse("200 OK", page, text)
      else:
        built = buildResponse("404 Not Found", "<h1>404 not found</h1>", text)
    else:
      built = buildResponse("404 Not Found", "<h1>404 not found</h1>", text)
    with connectionsLock:
      responseTexts[request.slot].clear()
      if built:
        if not responseTexts[request.slot].copyFrom(text):
          echo "response allocation failed"
    # Even on allocation failure, deliver the slot so the writer closes it.
    responses.send(request.slot)

# Shared strings remain global owners. The local copy permits socket IO
# outside the lock; no reference into shared storage survives unlocking.
thread writer() =
  loop:
    let slot = responses.recv()
    var text: string
    var socket: int32 = 0
    with connectionsLock:
      if connections[slot].socket > 0 and connections[slot].busy:
        socket = connections[slot].socket
        if not text.copyFrom(responseTexts[slot]):
          echo "writer allocation failed"
        responseTexts[slot].clear()
    if socket > 0:
      if not writeAll(socket, text):
        echo "response write failed"
      discard socket.close()
      with connectionsLock:
        connections[slot].socket = 0
        connections[slot].busy = false
