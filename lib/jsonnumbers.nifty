import jsontypes

func jsonNumberDigit(value: int): bool =
  # Test the ASCII decimal digit range.
  return value >= 48 and value <= 57

func jsonNumberDelimiter(value: int): bool =
  # Recognize only JSON whitespace and structural token boundaries.
  if value == 32 or value == 9 or value == 10 or value == 13:
    return true
  return value == 44 or value == 93 or value == 125

proc jsonScanNumber(text: string, start: int, error: var JsonError): int =
  # Validate a JSON number, returning its exclusive end or minus one.
  if start < 0 or start >= text.len:
    discard jsonFail(error, start, JsonNumberError, "Expected a JSON number")
    return -1
  # States: start, minus, zero, integer, dot, fraction, exponent,
  # exponent sign, exponent digits. Keep the lexeme exact in the tree.
  var state: 0 .. 8 = 0
  for i in start ..< text.len:
    let value = text[i]
    if state == 0 or state == 1:
      if state == 0 and value == 45:
        state = 1
      elif value == 48:
        state = 2
      elif value >= 49 and value <= 57:
        state = 3
      else:
        discard jsonFail(error, i, JsonNumberError, "Expected a digit in JSON number")
        return -1
    elif state == 2 or state == 3 or state == 5 or state == 8:
      if jsonNumberDigit(value):
        if state == 2:
          discard jsonFail(error, i, JsonNumberError, "Leading zero in JSON number")
          return -1
      elif value == 46 and (state == 2 or state == 3):
        state = 4
      elif (value == 101 or value == 69) and state != 8:
        state = 6
      elif jsonNumberDelimiter(value):
        return i
      else:
        discard jsonFail(error, i, JsonNumberError, "Invalid character in JSON number")
        return -1
    elif state == 4:
      if jsonNumberDigit(value):
        state = 5
      else:
        discard jsonFail(error, i, JsonNumberError, "Expected a fractional digit")
        return -1
    elif state == 6:
      if value == 43 or value == 45:
        state = 7
      elif jsonNumberDigit(value):
        state = 8
      else:
        discard jsonFail(error, i, JsonNumberError, "Expected an exponent digit")
        return -1
    else:
      if jsonNumberDigit(value):
        state = 8
      else:
        discard jsonFail(error, i, JsonNumberError, "Expected an exponent digit")
        return -1
  if state == 2 or state == 3 or state == 5 or state == 8:
    return text.len
  discard jsonFail(error, text.len, JsonNumberError, "Incomplete JSON number")
  return -1
