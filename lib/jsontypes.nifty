# JSON numbers retain their exact decimal spelling, including large exponents.
const JsonNumberError = 2
const JsonSyntaxError = 3
const JsonUnicodeError = 4
const JsonAllocationError = 5
const JsonDepthError = 6
const JsonDefaultDepth = 512

object NullNode =
  discard

object BoolNode =
  value: bool

object NumNode =
  text: string

object StrNode =
  value: string

object ArrNode =
  items: seq[JsonNode]

object JsonField =
  name: string
  value: JsonNode

object ObjNode =
  fields: seq[JsonField]

type JsonNode = NullNode or BoolNode or NumNode or StrNode or ArrNode or ObjNode

object JsonError =
  offset: int
  code: int
  message: string[128]

# Records an error without allocating memory.
proc jsonFail(error: var JsonError, offset: int, code: int, message: string[128]): bool =
  error.offset = offset
  error.code = code
  error.message = message
  return false

# Copies a JSON value through the language's explicit owning operations.
proc jsonCopy(output: var JsonNode, source: JsonNode): bool =
  if type(source) == NullNode:
    output = NullNode()
    return true
  elif type(source) == BoolNode:
    output = BoolNode(source.value)
    return true
  elif type(source) == NumNode:
    output = NumNode()
    if type(output) == NumNode:
      return output.text.copyFrom(source.text)
  elif type(source) == StrNode:
    output = StrNode()
    if type(output) == StrNode:
      return output.value.copyFrom(source.value)
  elif type(source) == ArrNode:
    output = ArrNode()
    if type(output) == ArrNode:
      return output.items.copyFrom(source.items)
  else:
    output = ObjNode()
    if type(output) == ObjNode:
      return output.fields.copyFrom(source.fields)
  return false

# Reads an exactly represented integer when it fits Nifty's int range.
func jsonInt(node: JsonNode): int? =
  if type(node) == NumNode:
    return node.text.toInt
  return none
